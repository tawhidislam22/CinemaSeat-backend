# Database Configuration
DATABASE_URL=postgres://postgres:postgres@db:5432/cinemaseat

# Gateway Integration
GATEWAY_URL=http://localhost:9000
CALLBACK_URL=http://localhost:8080/webhooks/payment

# Service Discovery (URLs for local dev without Docker)
SEATS_SERVICE_URL=http://localhost:3002
OTP_SERVICE_URL=http://localhost:3005
PAYMENTS_SERVICE_URL=http://localhost:3004
BOOKINGS_SERVICE_URL=http://localhost:3003
REDIS_URL=redis://localhost:6379

# Application Settings
HOLD_TTL_SECONDS=120
JWT_SECRET=replace_with_a_long_random_production_secret
GATEWAY_SECRET=super_secret_gateway_key_here

# Supplied hackathon OTP gateway
# Set to deterministic while developing; leave blank to exercise failures.
MOCK_GATEWAY_MODE=deterministic
OTP_INTERNAL_SECRET=replace_with_a_long_random_internal_secret

